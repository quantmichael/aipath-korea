# Supabase public project URL
SUPABASE_URL=

# Server-side secret. Never expose this value in browser JavaScript.
SUPABASE_SECRET_KEY=

# Preview only: a separately issued key for a database role with strictly
# read-only access to public Opportunity data and the two read RPCs.
# Never use the service_role key here. Keep SUPABASE_SECRET_KEY Production-only.
SUPABASE_READ_ONLY_KEY=
AIPATH_READ_ONLY=0

# Used only by the Python API for AI recommendations.
OPENAI_API_KEY=

# Required for /api/collect/run. Vercel Cron can use CRON_SECRET.
COLLECT_SECRET=
CRON_SECRET=

# Required when 기업마당 source uses the official API collector.
BIZINFO_API_KEY=

# Collection safety limits.
MAX_SOURCES_PER_RUN=3
MAX_CANDIDATES_PER_SOURCE=5
